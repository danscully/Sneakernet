{
	"name": "sneakernet",
	"version": "0.1.1",
	"private": true,
	"type": "module",
	"description": "Sneakernet - fast directory sync with native copy engine",
	"scripts": {
		"dev": "vite dev",
		"build": "npm run build:native && vite build",
		"build:native": "node-gyp rebuild -C native",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "node-gyp rebuild -C native && vitest run",
		"test:watch": "vitest",
		"seed": "node scripts/seed.mjs",
		"desktop:prepare": "node scripts/prepare-desktop.mjs",
		"desktop:build": "npm run build && npm run desktop:prepare && npx tauri build --config desktop/src-tauri/tauri.conf.json",
		"desktop:build:win": "npm run build && node scripts/prepare-desktop.mjs --platform win32 --arch x64 && npx tauri build --config desktop/src-tauri/tauri.conf.json --target x86_64-pc-windows-msvc || npx tauri build --config desktop/src-tauri/tauri.conf.json"
	},
	"devDependencies": {
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"@tauri-apps/cli": "^2.11.4",
		"@types/node": "^26.4.1",
		"node-addon-api": "^8.9.2",
		"node-gyp": "^13.0.2",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"vite": "^8.2.2",
		"vitest": "^5.0.0"
	},
	"dependencies": {
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.41.0",
		"@sveltejs/kit": "^2.70.3",
		"bits-ui": "^2.19.0",
		"clsx": "^2.1.1",
		"svelte": "^5.57.0",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.3.1"
	}
}
