{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Sneakernet",
	"version": "0.1.0",
	"identifier": "com.sneakernet.desktop",
	"build": {
		"frontendDist": "../ui"
	},
	"app": {
		"windows": [
			{
				"label": "main",
				"title": "Sneakernet",
				"width": 1560,
				"height": 1000,
				"minWidth": 1100,
				"minHeight": 700
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"category": "Utility",
		"shortDescription": "Fast local directory sync",
		"longDescription": "Sneakernet syncs a directory on your computer to other directories using native-speed copies, live progress and a two-step compare/sync workflow.",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"resources": {
			"resources/server": "server",
			"resources/native": "native",
			"resources/runtime": "runtime"
		}
	}
}
